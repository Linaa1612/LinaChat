<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<!-- Parametres usuels du profil et du serveur, sans fonctionnalite tierce. -->
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.linachat.controller.SettingsController" spacing="14" styleClass="card">
    <padding><Insets top="24" right="30" bottom="24" left="30"/></padding>
    <Label text="Paramètres" styleClass="title"/>
    <Label text="Serveur" styleClass="section-label"/>
    <TextField promptText="Adresse IP" text="127.0.0.1"/>
    <TextField promptText="Port" text="5050"/>
    <Button text="Enregistrer" styleClass="primary-button"/>
</VBox>
